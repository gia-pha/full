# Auth service
PROTO=http
HOST=localhost
PORT=:8080
WEBAUTHN_NAME=Gia Pha
WEBAUTHN_ID=localhost
ALLOWED_ORIGINS=http://localhost:8081
LOG_LEVEL=DEBUG

# Frontend: base url the browser uses for /api calls. Vite bakes it into the
# bundle, so rebuild after changing it: docker compose build frontend
# http://localhost:8080 -> the auth service (live mode)
# http://localhost:8090 -> the pact stub server (docker compose up -d stub-server)
VITE_AUTH_BACKEND_URL=http://localhost:8080

# Pact broker. Not part of docker compose anymore: only set this to a broker
# you run elsewhere (e.g. PactFlow) to verify provider contracts against it.
# Without it auth/contracts verifies the pact files committed under frontend/pacts.
# PACT_BROKER_URL=
# Only needed for token-authenticated brokers (e.g. PactFlow).
# PACT_BROKER_TOKEN=
